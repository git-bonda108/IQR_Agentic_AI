{
  "control_id": "C23024",
  "version": "1.0.0",
  "frequency": "quarterly",
  "description": "Control C23024 - Quarterly Partner Rebate Calculation. The financial analyst recomputes partner rebates from the certified sales extract; the controller reviews and approves the calculation before posting.",
  "expected_evidence": [
    {
      "id": "e_wb",
      "description": "Rebate calculation workbook",
      "match_hints": [
        "rebate"
      ],
      "required": true
    },
    {
      "id": "e_approval",
      "description": "Controller approval email",
      "match_hints": [
        "approval_C23024"
      ],
      "required": true
    }
  ],
  "checks": [
    {
      "id": "n1",
      "check_type": "numeric",
      "description": "Regional sales foot to the quarterly total",
      "inputs": [
        "e_wb"
      ],
      "params": {
        "op": "sum_equals",
        "source": {
          "evidence": "e_wb",
          "sheet": "Sales",
          "cells": [
            "B2",
            "B3",
            "B4",
            "B5"
          ]
        },
        "target": {
          "evidence": "e_wb",
          "sheet": "Sales",
          "cell": "B7"
        },
        "tolerance": 0.01
      },
      "parallelizable": true
    },
    {
      "id": "n2",
      "check_type": "numeric",
      "description": "Rebate payable equals total sales times rate",
      "inputs": [
        "e_wb"
      ],
      "params": {
        "op": "product_equals",
        "source": {
          "evidence": "e_wb",
          "sheet": "Rebate",
          "cells": [
            "B2",
            "B3"
          ]
        },
        "target": {
          "evidence": "e_wb",
          "sheet": "Rebate",
          "cell": "B4"
        },
        "tolerance": 0.01
      },
      "parallelizable": true
    },
    {
      "id": "s1",
      "check_type": "signoff",
      "description": "Controller approval postdates preparation, SoD held",
      "inputs": [
        "e_approval",
        "e_wb"
      ],
      "params": {
        "approval_email_evidence": "e_approval",
        "preparer": "priya.sharma",
        "prepared_at": {
          "evidence": "e_wb",
          "sheet": "Meta",
          "cell": "B1",
          "tz": "GMT"
        }
      },
      "parallelizable": true
    }
  ],
  "scope_exclusions": [],
  "signoff": {
    "preparer_role": "Financial Analyst",
    "approver_role": "Controller",
    "require_distinct": true,
    "require_order": true
  },
  "approved_by": "satya.bonda",
  "approved_at": "2026-08-18T11:14:34.238218Z"
}