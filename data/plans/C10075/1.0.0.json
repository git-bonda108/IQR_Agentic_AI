{
  "control_id": "C10075",
  "version": "1.0.0",
  "frequency": "quarterly",
  "description": "Control C10075 - Quarterly External Manufacturing Report (EMR) Review. The analyst ties screenshot IPE from the certified WEBI folder to the EMR workbook; the external reporting manager signs off. Preparer and reviewer must be distinct.",
  "expected_evidence": [
    {
      "id": "e_wb",
      "description": "EMR review workbook",
      "match_hints": [
        "emr_workbook"
      ],
      "required": true
    },
    {
      "id": "e_shot",
      "description": "Screenshot IPE of certified extract",
      "match_hints": [
        "screenshot"
      ],
      "required": true
    },
    {
      "id": "e_approval",
      "description": "Manager sign-off email",
      "match_hints": [
        "approval_C10075"
      ],
      "required": true
    }
  ],
  "checks": [
    {
      "id": "v1",
      "check_type": "vision",
      "description": "Screenshot total quantity ties to workbook",
      "inputs": [
        "e_shot",
        "e_wb"
      ],
      "params": {
        "label": "Total Qty",
        "image_evidence": "e_shot",
        "target": {
          "evidence": "e_wb",
          "sheet": "EMR",
          "cell": "C7"
        },
        "tolerance": 0
      },
      "parallelizable": true
    },
    {
      "id": "s1",
      "check_type": "signoff",
      "description": "Manager sign-off postdates preparation, SoD held",
      "inputs": [
        "e_approval",
        "e_wb"
      ],
      "params": {
        "approval_email_evidence": "e_approval",
        "preparer": "dana.wu",
        "prepared_at": {
          "evidence": "e_wb",
          "sheet": "Meta",
          "cell": "B1",
          "tz": "GMT"
        }
      },
      "parallelizable": true
    }
  ],
  "scope_exclusions": [],
  "signoff": {
    "preparer_role": "Reporting Analyst",
    "approver_role": "External Reporting Manager",
    "require_distinct": true,
    "require_order": true
  },
  "approved_by": "satya.bonda",
  "approved_at": "2026-08-18T11:14:34.601737Z"
}