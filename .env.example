# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# Model modes: stub (offline, default) | davinci (hard requirement) | auto (fallback chain)
IQR_MODEL=auto

# Primary: the approved DaVinci endpoint (OpenAI-compatible chat completions)
DAVINCI_API_URL=https://your-model-gateway/v1/chat/completions
DAVINCI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# Optional secondary approved endpoint (same wire format) - tried if DaVinci fails
IQR_SECONDARY_API_URL=
IQR_SECONDARY_API_KEY=

# Azure AI Foundry model seat (IQR_MODEL=foundry, or first in the auto chain
# when configured). Endpoint is the Foundry project's Azure OpenAI endpoint.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_API_VERSION=2024-10-21

# Foundry IQ knowledge retrieval (Control KB / Golden Library). When set,
# retrieval asks the knowledge base first and falls back to the local index.
FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_API_KEY=
FOUNDRY_IQ_KNOWLEDGE_BASE=

# MCP server transport: stdio (default) | streamable-http | sse
IQR_MCP_TRANSPORT=stdio

# Per-seat model routing (seats: PLAN_COMPILE, VISION, TEMPORAL, SIGNOFF, VERIFY).
# A newly security-approved model earns a seat here AFTER passing the five eval
# gates; unset seats inherit IQR_MODEL / AZURE_FOUNDRY_DEPLOYMENT.
#IQR_MODEL_VERIFY=davinci
#IQR_FOUNDRY_DEPLOYMENT_PLAN_COMPILE=gpt-5-chat

# Keep 1 so the deterministic stub catches runs when every endpoint is down
# (which backend answered each call is recorded in the run ledger).
IQR_STUB_FALLBACK=1
