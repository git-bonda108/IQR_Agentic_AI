# Copy to .env and fill in. NEVER commit .env - it is gitignored.
# Model modes: stub (offline, default) | davinci (hard requirement) | auto (fallback chain)
IQR_MODEL=auto

# Primary: the approved DaVinci endpoint (OpenAI-compatible chat completions)
DAVINCI_API_URL=https://your-model-gateway/v1/chat/completions
DAVINCI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# Optional secondary approved endpoint (same wire format) - tried if DaVinci fails
IQR_SECONDARY_API_URL=
IQR_SECONDARY_API_KEY=

# Keep 1 so the deterministic stub catches runs when every endpoint is down
# (which backend answered each call is recorded in the run ledger).
IQR_STUB_FALLBACK=1
